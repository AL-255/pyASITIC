; 3.45 1P2M (without MIM, 30KA TM)
; Source: https://gf180mcu-pdk.readthedocs.io/en/latest/analog/layout/inter_specs/inter_specs_3_45.html
; Upstream revision: de3240d7529a6970437ac3344820aaae7839f215
; Nominal BEOL geometry and sheet R. Substrate 10 ohm-cm / 700 um is ASSUMED.
; Planar coil model: ILD/IMD/oxide passivation eps=4, nitride passivation eps=7.
; Local STI/poly/conformal liner and local MIM nitride are not blanket layers.
; MIM plate geometry is included; CAP is not a calibrated MIM capacitor model.
; Air 100 um and dielectric rho=1e10 ohm-cm are modeling assumptions.
; Via spacing 0.36 um covers the published >=4x4-array rule; enclosure 0.12 um.
; GDS uses GF180 drawn layer numbers. Additional device/marker rules still apply.

<chip>
chipx = 512
chipy = 512
fftx = 128
ffty = 128
TechFile = gf180-1p2m-30ka-no-mim.tek
TechPath = .
freq = 2
eddy = 0
gds_m1 = 34
gds_m2 = 36
gds_via1 = 35

<layer> 0
t = 700
rho = 10
eps = 11.9

<layer> 1
t = 5.31
rho = 1e10
eps = 4

<layer> 2
t = 0.3
rho = 1e10
eps = 7

<layer> 3
t = 100
rho = 1e10
eps = 1

<metal> 0
name = M1
layer = 1
d = 0.86
t = 0.55
rsh = 90
color = #81b4ef

<metal> 1
name = M2
layer = 1
d = 2.01
t = 3
rsh = 8.3
color = #f0b567

<via> 0
name = VIA1
bottom = 0
top = 1
r = 4.5
width = 0.26
space = 0.36
overplot1 = 0.12
overplot2 = 0.12
